{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm install && npm run build",
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard/:path*",
      "destination": "/dashboard/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "regions": [
    "sin1"
  ]
}
