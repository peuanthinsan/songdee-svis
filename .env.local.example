# Auth
JWT_SECRET=replace-with-long-random-string

# Neon Postgres
DATABASE_URL=postgresql://...@...neon.tech/svis?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://...@...neon.tech/svis?sslmode=require

# Vercel Blob (defect / completion / odometer photos)
