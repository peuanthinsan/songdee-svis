# SendGrid (fleet-manager fail notifications)
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@songdeegps.com
EMAIL_ENABLED=false

# API URL for mobile app
EXPO_PUBLIC_API_URL=http://localhost:3000
